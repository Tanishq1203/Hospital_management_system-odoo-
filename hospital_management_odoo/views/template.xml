<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="patients_page" name="Hospital Patients">
        <t t-call="website.layout">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <h2>Hospital Patients</h2>
                        <table class="table table-bordered table-striped" background-color = "#D6EEEE">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Name</th>
                                    <th>Age</th>
                                    <th>Gender</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="patients" t-as="patient">
                                    <tr>
                                        <td><t t-esc="patient.name"/></td>
                                        <td><t t-esc="patient.age"/></td>
                                        <td><t t-esc="patient.gender"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
