<!-- views/account_move_views.xml -->
<odoo>
    <data>
        <!-- Inherit the existing account.move form view -->
        <record id="view_move_form_inherit_patient" model="ir.ui.view">
            <field name="name">account.move.form.inherit.patient</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="patient_id" string = "Patient Name :"/>
                    <field name="doctor_id" string = "Doctor Name :" />
                    <field name="appointment_id" string = "Appointment ID :" />
                </xpath>
                <xpath expr="/form/sheet/notebook/page[1]/field[@name='invoice_line_ids']"
                    position="after">
                    <group>
                        <field name="medicine_ids" string = "Medicine"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
