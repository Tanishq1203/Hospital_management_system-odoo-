<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medicine Views -->
    <record id="view_medicine_tree" model="ir.ui.view">
        <field name="name">pharmacy.medicine.tree</field>
        <field name="model">pharmacy.medicine</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="price"/>
                <field name="stock_quantity"/>
            </tree>
        </field>
    </record>

    <record id="view_medicine_form" model="ir.ui.view">
        <field name="name">pharmacy.medicine.form</field>
        <field name="model">pharmacy.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="price"/>
                        <field name="stock_quantity"/>
                        <field name="units" widget="selection_badge"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medicine Action -->
    <record id="action_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">pharmacy.medicine</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
