<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Doctore report template  -->
    <template id="report_doctor_detail">
        <div class="col-6" name="watermark">
            <span style="-webkit-transform: rotate(-20deg); color: coral; font-size: 9em; text-align: left; position: absolute; opacity: 0.9;">
                Jyot Hospital Doctor Report
            </span>
        </div>
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row">
                            <div class="col-xs-8">
                                <table class="table table-condensed" style="border: 2px solid black !important;">
                                    <tr>
                                        <td width="40%">
                                            <p style="text-align:center;padding-top:10px;">
                                                <img t-if="not o.image"
                                                     t-att-src="'/web/static/src/img/placeholder.png'" height="140"
                                                     border="1" width="120"/>
                                                <img t-if="o.image"
                                                     t-att-src="'data:image/png;base64,%s' % to_text(o.image)"
                                                     height="140" border="1" width="120"/>
                                            </p>
                                        </td>
                                        <td width="40%">
                                            <table>
                                                <tr>
                                                    <td colspan="2" class="text-center">
                                                        <span><strong>Name:</strong></span>
                                                        <span t-field="o.doctor_name"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><span><strong>Age:</strong></span></td>
                                                    <td><span>:</span></td>
                                                    <td><span t-field="o.age"/></td>
                                                </tr>
                                                <tr>
                                                    <td><span><strong>Gender:</strong></span></td>
                                                    <td><span>:</span></td>
                                                    <td><span t-field="o.gender"/></td>
                                                </tr>
                                                <tr>
                                                    <td><span><strong>Note:</strong></span></td>
                                                    <td><span>:</span></td>
                                                    <td><span t-field="o.note"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <br/>
                        <table class="table table-condensed">
                            <tr>
                                <td colspan="2"><strong>Total Appointments</strong></td>
                                <td>
                                    <t t-set="appointment_count"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
