<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Actions  -->
    <record id="report_patient_details" model="ir.actions.report">
        <field name="name">Patient Details</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jyot_hospital_management.report_patient_detail</field>
        <field name="report_file">jyot_hospital_management.report_patient_detail</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_patient_card" model="ir.actions.report">
        <field name="name">Patient Card</field>
        <field name="model">hospital.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jyot_hospital_management.report_patient_id_card</field>
        <field name="report_file">jyot_hospital_management.report_patient_id_card</field>
        <field name="binding_model_id" ref="model_hospital_patient"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_doctor_details" model="ir.actions.report">
        <field name="name">Doctor Report</field>
        <field name="model">hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jyot_hospital_management.report_doctor_detail</field>
        <field name="report_file">jyot_hospital_management.report_doctor_detail</field>
        <field name="binding_model_id" ref="model_hospital_doctor"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_hospital_appointment" model="ir.actions.report">
        <field name="name">Appointment Report</field>
        <field name="model">hospital.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jyot_hospital_management.report_appointment_details</field>
        <field name="report_file">jyot_hospital_management.report_appointment_details</field>
        <field name="binding_model_id" ref="model_hospital_appointment"/>
        <field name="binding_type">report</field>
    </record>


</odoo>
