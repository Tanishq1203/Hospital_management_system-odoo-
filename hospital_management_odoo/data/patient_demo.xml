<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sample Responsible Partners -->
        <record id="partner_1" model="res.partner">
            <field name="name">John Doe</field>
            <field name="email">john.doe@example.com</field>
        </record>
        <record id="partner_2" model="res.partner">
            <field name="name">Jane Smith</field>
            <field name="email">jane.smith@example.com</field>
        </record>

        <!-- Sample Patients -->
        <record id="patient_1" model="hospital.patient">
            <field name="name">Michael Johnson</field>
            <field name="reference">HP00001</field>
            <field name="age">35</field>
            <field name="gender">male</field>
            <field name="note">Patient with a history of hypertension.</field>
            <field name="state">confirm</field>
            <field name="responsible_id" ref="partner_1"/>
        </record>
        <record id="patient_2" model="hospital.patient">
            <field name="name">Emily Davis</field>
            <field name="reference">HP00002</field>
            <field name="age">28</field>
            <field name="gender">female</field>
            <field name="note">Patient with a history of asthma.</field>
            <field name="state">draft</field>
            <field name="responsible_id" ref="partner_2"/>
        </record>
        <record id="patient_3" model="hospital.patient">
            <field name="name">William Williams</field>
            <field name="reference">HP00003</field>
            <field name="age">40</field>
            <field name="gender">other</field>
            <field name="note">Patient recovering from surgery.</field>
            <field name="state">done</field>
            <field name="responsible_id" ref="partner_1"/>
        </record>
    </data>
</odoo>

