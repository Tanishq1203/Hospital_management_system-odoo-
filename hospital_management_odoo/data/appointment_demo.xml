<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sample Patients -->
        <record id="patient_1" model="hospital.patient">
            <field name="name">John Doe</field>
            <field name="age">30</field>
            <field name="gender">male</field>
        </record>
        <record id="patient_2" model="hospital.patient">
            <field name="name">Jane Smith</field>
            <field name="age">25</field>
            <field name="gender">female</field>
        </record>

        <!-- Sample Doctors -->
        <record id="doctor_1" model="hospital.doctor">
            <field name="doctor_name">Dr. Alice Brown</field>
            <field name="age">45</field>
            <field name="gender">female</field>
        </record>
        <record id="doctor_2" model="hospital.doctor">
            <field name="doctor_name">Dr. Bob Johnson</field>
            <field name="age">50</field>
            <field name="gender">male</field>
        </record>

        <!-- Sample Appointments -->
        <record id="appointment_1" model="hospital.appointment">
            <field name="name">APT00001</field>
            <field name="patient_id" ref="patient_1"/>
            <field name="doctor_id" ref="doctor_1"/>

            <field name="state">confirm</field>
            <field name="note">General checkup</field>
        </record>
        <record id="appointment_2" model="hospital.appointment">
            <field name="name">APT00002</field>
            <field name="patient_id" ref="patient_2"/>
            <field name="doctor_id" ref="doctor_2"/>

            <field name="state">draft</field>
            <field name="note">Follow-up visit</field>
        </record>

        <!-- Sample Tags -->
        <record id="tag_routine" model="hospital.tags">
            <field name="name">Routine</field>
        </record>
        <record id="tag_emergency" model="hospital.tags">
            <field name="name">Emergency</field>
        </record>

        <!-- Assign Tags to Appointments -->
        <record id="appointment_1" model="hospital.appointment">
            <field name="tags" eval="[(6, 0, [ref('tag_routine')])]"/>
        </record>
        <record id="appointment_2" model="hospital.appointment">
            <field name="tags" eval="[(6, 0, [ref('tag_emergency')])]"/>
        </record>
    </data>
</odoo>
