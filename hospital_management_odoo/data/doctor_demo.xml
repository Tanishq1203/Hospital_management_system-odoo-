<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sample Specialization Tags -->
        <record id="tag_cardiology" model="hospital.tags">
            <field name="name">Cardiology</field>
        </record>
        <record id="tag_neurology" model="hospital.tags">
            <field name="name">Neurology</field>
        </record>
        <record id="tag_orthopedics" model="hospital.tags">
            <field name="name">Orthopedics</field>
        </record>

        <!-- Sample Doctors -->
        <record id="doctor_1" model="hospital.doctor">
            <field name="doctor_name">Dr. Alice Brown</field>
            <field name="age">45</field>
            <field name="gender">female</field>
            <field name="note">Specializes in cardiology and neurology.</field>
            <field name="tags" eval="[(6, 0, [ref('tag_cardiology'), ref('tag_neurology')])]"/>
            <field name="active">True</field>
        </record>
        <record id="doctor_2" model="hospital.doctor">
            <field name="doctor_name">Dr. Bob Johnson</field>
            <field name="age">50</field>
            <field name="gender">male</field>
            <field name="note">Specializes in orthopedics.</field>
            <field name="tags" eval="[(6, 0, [ref('tag_orthopedics')])]"/>
            <field name="active">True</field>
        </record>
        <record id="doctor_3" model="hospital.doctor">
            <field name="doctor_name">Dr. Charlie Davis</field>
            <field name="age">38</field>
            <field name="gender">male</field>
            <field name="note">General practitioner with a focus on family medicine.</field>
            <field name="tags" eval="[(6, 0, [])]"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
